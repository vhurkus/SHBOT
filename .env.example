# ====================================
# API Credentials (REQUIRED)
# ====================================
BTCTURK_API_KEY=your_btcturk_api_key_here
BTCTURK_API_SECRET=your_btcturk_api_secret_here
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ====================================
# Trading Configuration
# ====================================
# Her iki borsa da USDT paritesi kullanacak
TRADE_SYMBOL=XRPUSDT
BASE_COIN=XRP
QUOTE_COIN=USDT

# Binance paritesi (aynı)
BINANCE_SYMBOL=XRPUSDT
BINANCE_BASE_COIN=XRP
BINANCE_QUOTE_COIN=USDT

# İşlem parametreleri
TRADE_AMOUNT=10
MIN_PROFIT_PERCENT=0.1
MIN_SPREAD_PERCENT=0.3
PRICE_UPDATE_THRESHOLD=0.2

# İşlem ücretleri (%)
BTCTURK_MAKER_FEE=0.0018
BTCTURK_TAKER_FEE=0.0024
BINANCE_MAKER_FEE=0.001
BINANCE_TAKER_FEE=0.001

# Decimal precision
PRICE_PRECISION=4
QUANTITY_PRECISION=2

# ====================================
# Safety Limits
# ====================================
MAX_DAILY_TRADES=100
MAX_DAILY_LOSS=20
MIN_XRP_BALANCE=10
MIN_USDT_BALANCE=10

# ====================================
# Monitoring Settings
# ====================================
ORDER_CHECK_INTERVAL=1000
BALANCE_CHECK_INTERVAL=5000
PRICE_CHECK_INTERVAL=100

# WebSocket
WS_PING_INTERVAL=30000
WS_RECONNECT_DELAY=5000
WS_MAX_RECONNECT=10

# ====================================
# Advanced Features (Optional)
# ====================================
# Dry run mode (test mode, no real orders)
DRY_RUN=false

# Order book depth analysis
USE_ORDERBOOK_DEPTH=false
ORDERBOOK_DEPTH=10

# Dynamic spread adjustment
DYNAMIC_SPREAD=false

# ====================================
# Notifications (Optional)
# ====================================
NOTIFICATIONS_ENABLED=false

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email
EMAIL_ENABLED=false
EMAIL_FROM=
EMAIL_TO=

# ====================================
# Environment & Logging
# ====================================
NODE_ENV=development
LOG_LEVEL=info
ENABLE_TRADE_LOG=true
ENABLE_API_LOG=false
